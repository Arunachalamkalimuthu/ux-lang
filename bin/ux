#!/usr/bin/env node
import { readFile, writeFile, mkdir } from 'node:fs/promises';
import { join } from 'node:path';
import { loadProject, findUxFiles } from '../src/project.js';
import { formatSource } from '../src/format.js';
import { link } from '../src/linker.js';
import { renderMap } from '../src/map.js';
import { renderDiagnostics } from '../src/report.js';
import { lint } from '../src/lint.js';
import { hasErrors, ERROR } from '../src/diagnostics.js';

// Ordering is a CLI presentation concern, not part of what a diagnostic
// *is* — renderDiagnostics stays a pure formatter that prints whatever list
// it's handed. Diagnostics arrive from several independent passes (lexer,
// parser, check.js per file, then linker.js across several internal loops
// that each finish before the next starts), so the unsorted list jumps
// around by line and even by file. Sort by file, then line, then code, so
// a human reads a project top to bottom instead of in pass order.
//
// Lexical diagnostics (UX001–UX004) get a phase ahead of everything else.
// This lexer resets its string/indent state at each line boundary, so a
// lexical error corrupts exactly one line — every other diagnostic in the
// run is derived from a cleanly parsed line and is exactly as trustworthy
// as normal, including ones for entirely unrelated files (the blocker-2
// repro's `UX201` on `other.ux`, which has no lexical error of its own).
// Suppressing the rest of the run on a lexical error would silence real,
// independent findings in every other file — on a twenty-file project, one
// stray quote would hide every other error, silently. So nothing is
// suppressed; lexical errors are just guaranteed to be read first, because
// they're the ones whose *derived* diagnostics (a vanished `->`, a
// swallowed comment) may be noise until they're fixed.
const LEXICAL_CODES = new Set(['UX001', 'UX002', 'UX003', 'UX004']);

function sortDiagnostics(diags) {
  return [...diags].sort((a, b) => {
    const phase = Number(LEXICAL_CODES.has(b.code)) - Number(LEXICAL_CODES.has(a.code));
    if (phase !== 0) return phase;
    return a.file.localeCompare(b.file) || a.line - b.line || a.code.localeCompare(b.code);
  });
}

const USAGE = `ux — check, lint, format and map .ux projects

  ux check [dir]   validate a project (default dir: ux)
  ux lint  [dir]   report smells in a project that already checks
  ux fmt   [dir]   rewrite files in canonical layout
  ux map   [dir]   print the flow graph and write <dir>/.build/app.map

  --strict         make warnings fail (exit 1); for CI
  --check          with fmt: report what would change, write nothing
`;

// Flags are pulled out first so they can appear anywhere — `ux check --strict
// ux/` and `ux check ux/ --strict` are the same command, and a flag can never
// be mistaken for the directory.
//
// Both halves are then checked rather than trimmed to the two the parse
// happens to want. Dropping the rest is the wrong way for a CLI to fail:
// `ux fmt --list-different` — Prettier's spelling of `--check` — rewrote every
// file in place and exited 0, `ux check --strict=true` turned the CI gate off
// without saying so, and `ux check a b` checked `a` and never mentioned `b`.
const KNOWN_FLAGS = new Set(['--strict', '--check', '--help']);
const argv = process.argv.slice(2);
const flags = argv.filter(a => a.startsWith('-'));
const positional = argv.filter(a => !a.startsWith('-'));

const unknownFlag = flags.find(flag => !KNOWN_FLAGS.has(flag));
if (unknownFlag) {
  process.stdout.write(`Unknown flag \`${unknownFlag}\`.\n  fix:  the only flags are --strict and --check\n`);
  process.exit(1);
}

const strict = flags.includes('--strict');
const checkOnly = flags.includes('--check');
const [command, dirArg, ...extra] = positional;
const dir = dirArg ?? 'ux';

if (!command || command === 'help' || flags.includes('--help')) {
  process.stdout.write(USAGE);
  process.exit(0);
}

// Validate the command before touching the filesystem — otherwise a typo'd
// command against a project that fails to load (the ordinary first-run
// state: no `ux/` directory yet) gets misreported as a missing-directory
// error instead of naming the actual mistake.
if (!['check', 'lint', 'fmt', 'map'].includes(command)) {
  process.stdout.write(`Unknown command \`${command}\`.\n  fix:  ux check\n`);
  process.exit(1);
}

if (extra.length > 0) {
  process.stdout.write(`Unexpected argument \`${extra[0]}\` — \`ux ${command}\` takes one directory.\n  fix:  ux ${command} ${dir}\n`);
  process.exit(1);
}

// `fmt` runs before anything parses. Formatting is pure text work, and a file
// that does not parse is exactly when you most want it tidied — requiring a
// clean project first would deny the tool to the person who needs it.
if (command === 'fmt') {
  let files;
  try {
    files = await findUxFiles(dir);
  } catch (error) {
    process.stdout.write(`Could not read \`${dir}\`: ${error.message}\n  fix:  create a ${dir}/ directory with .ux files\n`);
    process.exit(1);
  }

  if (files.length === 0) {
    process.stdout.write(`\`${dir}\` has no .ux files.\n  fix:  write at least one .ux file in ${dir}/\n`);
    process.exit(1);
  }

  // A file this pass cannot handle is reported and skipped, not thrown. An
  // uncaught read error used to abort the loop part-way: files earlier in the
  // sorted walk had already been rewritten, files after it had not, and the
  // run said nothing about either.
  const changed = [];
  const skipped = [];
  for (const path of files) {
    let bytes;
    try {
      bytes = await readFile(path);
    } catch (error) {
      skipped.push({ path, reason: error.message });
      continue;
    }

    // `readFile(…, 'utf8')` turns every byte it cannot decode into U+FFFD, so
    // writing the decoded text back would make a lossy read permanent. A
    // formatter may not destroy what it could not read in the first place.
    const source = bytes.toString('utf8');
    if (!Buffer.from(source, 'utf8').equals(bytes)) {
      skipped.push({ path, reason: 'not valid UTF-8 — formatting it would replace the bytes that could not be decoded' });
      continue;
    }

    const formatted = formatSource(source);
    if (formatted === source) continue;
    changed.push(path);
    if (!checkOnly) await writeFile(path, formatted);
  }

  if (skipped.length > 0) {
    const lines = skipped.map(s => `  ${s.path}: ${s.reason}`).join('\n');
    process.stdout.write(`Could not format ${skipped.length} file(s):\n${lines}\n  fix:  make each one readable and valid UTF-8, then re-run\n\n`);
  }

  if (changed.length === 0) {
    process.stdout.write(`${files.length - skipped.length} file(s) already formatted.\n`);
    process.exit(skipped.length > 0 ? 1 : 0);
  }

  const verb = checkOnly ? 'would be reformatted' : 'reformatted';
  process.stdout.write(`${changed.map(p => `  ${p}`).join('\n')}\n\n${changed.length} file(s) ${verb}.\n`);
  // --check is for CI: report and fail, write nothing.
  process.exit(checkOnly || skipped.length > 0 ? 1 : 0);
}

let programs, diags;
try {
  ({ programs, diags } = await loadProject(dir));
} catch (error) {
  process.stdout.write(`Could not read \`${dir}\`: ${error.message}\n  fix:  create a ${dir}/ directory with .ux files\n`);
  process.exit(1);
}

// A directory that exists but holds zero `.ux` files loads without error —
// `loadProject` just finds nothing to read — and used to report "No
// problems found.", exiting 0 exactly when a generation step produced
// nothing. That is the empty-green-checkmark case, not a passing project.
// Report it in the same shape as the missing-directory error above, since
// from the caller's side it is the same mistake: there is nothing here to
// check yet.
if ((command === 'check' || command === 'lint') && programs.length === 0) {
  process.stdout.write(`\`${dir}\` has no .ux files.\n  fix:  write at least one .ux file in ${dir}/\n`);
  process.exit(1);
}

const linked = link(programs);
const errors = sortDiagnostics([...diags, ...linked.diags]);
const warnings = sortDiagnostics(lint(programs));

// Warnings fail the build only when asked. A lint rule that cannot be ignored
// is an error wearing the wrong label, and every rule here has a legitimate
// exception — but CI wants a way to hold a line, so --strict provides one.
const failed = list => hasErrors(list) || (strict && list.length > 0);

if (command === 'lint') {
  process.stdout.write(renderDiagnostics(warnings) + '\n');
  process.exit(failed(warnings) ? 1 : 0);
}

if (command === 'check') {
  // Warnings ride along with `check` rather than waiting for a second command
  // nobody remembers to run — but they sort after every error, because an
  // error is what stops you shipping.
  const all = [...errors, ...warnings];
  const lexicalCount = all.filter(d => LEXICAL_CODES.has(d.code)).length;
  const banner = lexicalCount > 0
    ? `${lexicalCount} lexical error(s). Fix these first and re-run — anything below may be derived from a broken line.\n\n`
    : '';
  process.stdout.write(banner + renderDiagnostics(all) + '\n');
  process.exit(failed(all) ? 1 : 0);
}

const all = errors;

// command === 'map': always exits 0 — a map of a broken project is exactly
// what you want when hunting a dead end. But it isn't silent about errors:
// it appends a one-line count so they aren't mistaken for a clean project.
const map = renderMap(linked);
const errorCount = all.filter(d => d.severity === ERROR).length;
const output = errorCount > 0
  ? `${map}\n${errorCount} error(s) — run \`ux check\` for details\n`
  : `${map}\n`;
process.stdout.write(output);

// The map is already on stdout, so a failure to save it costs the reader
// nothing they were looking at — but it is still a failure, and every other
// I/O path here reports one rather than letting a Node stack trace out.
try {
  await mkdir(join(dir, '.build'), { recursive: true });
  await writeFile(join(dir, '.build', 'app.map'), output);
} catch (error) {
  process.stdout.write(`Could not write \`${join(dir, '.build', 'app.map')}\`: ${error.message}\n  fix:  make ${join(dir, '.build')} a writable directory, or remove what is in its place\n`);
  process.exit(1);
}

process.exit(0);
